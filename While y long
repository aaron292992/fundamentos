#include <iostream>
using namespace std;

int main() {
    int N;
    int i = 1;
    long long S = 0;  

    cout << "Ingrese el valor de N: ";
    cin >> N;

    while (i <= N) {
        S += i;
        i++;
    }

    cout << "La suma S = 1 + 2 + ... + " << N << " es: " << S << endl;

    return 0;
}
